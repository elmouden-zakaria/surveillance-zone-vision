<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="12dp"
    android:fitsSystemWindows="true"> <!-- Garde l'affichage hors de la barre système -->

    <!-- Flux Vidéo (WebView) occupant la partie supérieure -->
    <WebView
        android:id="@+id/webViewStream"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000" />

    <!-- Options / RadioButtons gérés par un RadioGroup pour l'exclusion mutuelle -->
    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <RadioButton
            android:id="@+id/rbStepway"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stepway"
            android:textColor="#FFFFFF"
            android:buttonTint="#FFFFFF"
            android:checked="true"
            android:layout_marginEnd="24dp"/>

        <RadioButton
            android:id="@+id/rbXjk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XJK"
            android:textColor="#FFFFFF"
            android:buttonTint="#FFFFFF"/>
    </RadioGroup>

    <!-- Zone d'état et de logs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ÉTAT DE SÉCURITÉ &amp; SCANNER"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvScannerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scanner Laser: EN ATTENTE..."
            android:textColor="#16A34A"
            android:textSize="12sp"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tvBimanualStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Validation Bimanuelle: NON PRESSÉ"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tvRawLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dernière trame reçue: Aucune"
            android:textColor="#AAAAAA"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- BOUTON D'URGENCE PLACÉ TOUT EN BAS -->
    <Button
        android:id="@+id/btnEmergencyStop"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="ARRÊT D'URGENCE (E-STOP)"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#DC2626"/>

</LinearLayout>